<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>fr.morfredus.AntRenamerQt</id>
  <name>Ant Renamer Qt</name>
  <summary>Rename many files at once</summary>
  <developer id="fr.morfredus">
    <name>Frédéric Biron</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>
  <description>
    <p>Ant Renamer Qt renames many files and folders in one go: replace, insert, move or delete text, enumerate, change case, regular expressions, names taken from a list, and tags read from MP3 files (ID3) and from images (EXIF, IPTC, XMP).</p>
    <p>It is the C++/Qt 6 port of Ant Renamer by Antoine Potten, developed alongside the original program, with its language files and help.</p>
  </description>
  <launchable type="desktop-id">fr.morfredus.AntRenamerQt.desktop</launchable>
