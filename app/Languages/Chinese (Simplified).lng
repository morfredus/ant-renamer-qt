Note for translators: If you want to complete this translation, simple search for the text <n/> that indicate new lines that should be translated.
Replace the English text by the correct translation, and once done you can send the file to antrenamer-contact@antp.be to have it included in the next update.
-->
<Application>
  <MainForm>
    <tbTabs Caption="页面"/>
    <tbProgram Caption="程序"/>
    <tbFiles Caption="文件"/>
    <tbMove Caption="移动项目"/>
    <tbActions Caption="操作"/>
    <tbLog Caption="日志"/>
    <ActionBatchAddAction Caption="添加到批处理" Hint="添加到批处理|将所选操作及其设置添加到批处理"/>
    <ActionBatchOpen Caption="打开…" Hint="打开|打开批处理文件"/>
    <ActionBatchSaveAs Caption="保存…" Hint="保存|将此批处理保存到文件"/>
    <ActionBatchRemoveSel Caption="移除所选" Hint="移除所选|从批处理中移除所选操作"/>
    <ActionBatchClear Caption="清空" Hint="清空批处理|移除批处理中的所有操作"/>
    <ActionBatchNoRecent Caption="（无最近文件）"/>
    <ActionAddFiles Caption="添加文件…" Hint="添加文件|将文件添加到列表"/>
    <ActionAddFolders Caption="添加文件夹…" Hint="添加文件夹|将文件夹或文件夹内容添加到列表"/>
    <ActionRemoveSelected Caption="移除所选" Hint="移除所选|从列表中移除所选文件"/>
    <ActionRemoveAll Caption="全部移除" Hint="全部移除|从列表中移除所有文件"/>
    <ActionRemoveDead Caption="移除无效项" Hint="移除无效项|从列表中移除无效文件"/>
    <ActionPreview Caption="预览" Hint="刷新预览|用当前计划的操作刷新预览列"/>
    <ActionChangedOnly Caption="仅已更改" Hint="仅已更改|仅显示预览中名称会改变的文件"/>
    <ActionFromListClear Caption="清空" Hint="清空列表|清空列表"/>
    <ActionFromListOpen Caption="打开…" Hint="打开|从文件加载列表"/>
    <ActionFromListSave Caption="保存…" Hint="保存|将列表保存到文件"/>
    <ActionMultistrReplClear Caption="清空表格" Hint="|清空字符串表格"/>
<n/>    <ActionMultistrReplCopy Caption="复制/导出" Hint="|将整个字符串表格以制表符分隔的文本复制到剪贴板，以便导入 Excel 或文本编辑器"/>
<n/>    <ActionMultistrReplPaste Caption="粘贴/导入" Hint="|从剪贴板以制表符分隔的文本粘贴整个字符串表格，用于从 Excel 或文本编辑器导入"/>
    <ActionMultistrReplSave Caption="保存" Hint="|以上面填写的名称保存当前集合"/>
    <ActionMultistrReplDelete Caption="删除" Hint="|删除当前选中的集合名称"/>
    <ActionMoveUp Caption="上移" Hint="上移|上移所选项目"/>
    <ActionMoveDown Caption="下移" Hint="下移|下移所选项目"/>
    <ActionMoveTop Caption="置顶" Hint="移到顶部|将所选项目移到列表顶部"/>
    <ActionMoveBottom Caption="置底" Hint="移到底部|将所选项目移到列表底部"/>
    <ActionItemsUnsort Caption="未排序项目" Hint="|取消当前排序顺序"/>
    <ActionItemsSelectAll Caption="全选" Hint="全选|选择所有项目"/>
    <ActionItemsSelectNone Caption="全不选" Hint="全不选|取消选择所有项目"/>
    <ActionItemsSelectInvert Caption="反选" Hint="反选|反转项目的选择"/>
    <ActionLogClear Caption="清空" Hint="清空|清空日志"/>
    <ActionLogSave Caption="保存…" Hint="保存|将日志保存到文件"/>
    <ActionLogCopy Caption="复制" Hint="复制|将日志复制到剪贴板"/>
    <ActionLogFilter Caption="筛选" Hint="筛选|筛选日志条目"/>
    <ActionLogFilterOk Caption="成功" Hint="显示已重命名文件|显示与成功重命名的文件对应的条目"/>
    <ActionLogFilterError Caption="错误" Hint="显示错误|显示与错误对应的条目"/>
    <ActionLogFilterNot Caption="未重命名" Hint="显示已跳过文件|显示与未重命名文件对应的条目"/>
    <ActionActionGo Caption="开始" Hint="开始|开始重命名过程"/>
    <ActionActionStop Caption="停止" Hint="停止|停止重命名过程"/>
    <ActionOptions Caption="选项…" Hint="选项|更改程序选项"/>
    <ActionActionUndo Caption="撤销" Hint="撤销|撤销上次重命名"/>
    <ActionHelpContents Caption="帮助" Hint="帮助内容|打开帮助内容"/>
    <ActionHelpAbout Caption="关于…" Hint="关于|关于本程序"/>
    <ActionExit Caption="退出" Hint="退出|退出程序"/>
    <ActionAlwaysOnTop Caption="置顶" Hint="总在最前|使窗口始终保持在最前面"/>
    <ActionTabFiles Caption="文件" Hint="文件|显示文件"/>
    <ActionTabActions Caption="操作" Hint="操作|显示操作"/>
    <ActionTabLog Caption="日志" Hint="日志|显示日志"/>
    <lstFiles Hint="|文件列表 - 在列标题上单击鼠标右键可自定义列">
      <Header>
        <Columns>
          <Item Index="0" Text="文件夹"/>
          <Item Index="1" Text="文件名"/>
          <Item Index="2" Text="完整路径"/>
          <Item Index="3" Text="扩展名"/>
          <Item Index="4" Text="预览"/>
          <Item Index="5" Text="大小"/>
          <Item Index="6" Text="创建日期"/>
          <Item Index="7" Text="修改日期"/>
        </Columns>
      </Header>
    </lstFiles>
    <grpPreview Caption="       所选文件的预览 "/>
    <grpBatch Caption="       批处理内容（计划的操作） "/>
    <lstBatch Hint="|批处理内容（计划的操作）"/>
    <lblPreviewOld Caption="当前名称："/>
    <lblPreviewNew Caption="新名称示例："/>
    <lstActions Hint="|操作列表">
      <Items>
        <Item Index="0" Value="更改扩展名"/>
        <Item Index="1" Value="字符串替换"/>
        <Item Index="2" Value="多字符串替换"/>
        <Item Index="3" Value="插入字符串"/>
        <Item Index="4" Value="移动字符串"/>
        <Item Index="5" Value="删除字符"/>
        <Item Index="6" Value="编号"/>
        <Item Index="7" Value="使用 MP3 标签信息"/>
        <Item Index="8" Value="使用日期和时间"/>
        <Item Index="9" Value="随机名称"/>
        <Item Index="10" Value="更改大小写"/>
        <Item Index="11" Value="从列表取名称"/>
        <Item Index="12" Value="正则表达式"/>
        <Item Index="13" Value="使用 EXIF 信息"/>
      </Items>
    </lstActions>
    <lblChangeExt Caption="将扩展名替换为："/>
    <cbxChangeExtNoRepl Caption="不替换扩展名，而是将其追加到当前完整名称"/>
    <lblChangeExtNotes Caption="说明：&lt;br&gt;- 不要包含点，只需输入新的扩展名&lt;br&gt;- 如需生成递增的扩展名，请使用&lt;LINK&gt;编号&lt;/LINK&gt;操作"/>
    <lblStrReplSearch Caption="搜索："/>
    <lblStrReplBy Caption="替换为："/>
    <cbxStrReplAll Caption="替换所有匹配项"/>
    <cbxStrReplCase Caption="区分大小写"/>
    <cbxStrReplExt Caption="搜索时包含扩展名"/>
    <cbxStrReplOnlyExt Caption="应用于扩展名而非名称"/>
    <cbxStrReplWildcards Caption="使用通配符（* = 任意文本，? = 任意字符）"/>
    <rbtStrReplAnywhere Caption="名称中的任意位置"/>
    <rbtStrReplBegin Caption="仅在开头"/>
    <rbtStrReplEnd Caption="仅在结尾"/>
    <lblMultstrSearch Caption="搜索："/>
    <lblMultstrReplBy Caption="替换为："/>
    <lblMultstrReplSet Caption="预定义集合："/>
    <cbxMultstrReplExt Caption="搜索时包含扩展名"/>
    <cbxMultstrCase Caption="区分大小写"/>
    <lblMultstrReplNotes Caption="说明：&lt;BR&gt;- 使用 Ctrl+加号 (+) 和 Ctrl+减号 (-) 在当前行位置插入或删除一行"/>
    <lblStrInsStr Caption="要插入的字符串："/>
    <lblStrInsPos Caption="位置："/>
    <rbtStrInsBegin Caption="从开头"/>
    <rbtStrInsEnd Caption="从结尾"/>
    <cbxStrInsExt Caption="应用于扩展名而非名称"/>
<n/>    <lblStrInsNotes Caption="说明：&lt;br&gt;- 如需在另一个字符串之前或之后插入字符串，请使用&lt;LINK&gt;字符串替换&lt;/LINK&gt;操作&lt;br&gt;- %name% = 原文件名（不含扩展名）&lt;BR&gt;- %ext% = 原扩展名（含点）&lt;BR&gt;- - %folderN% = 文件夹名称，N 为层级（1 = 当前，2 = 上级，依此类推）&lt;BR&gt;- %% = % 字符&lt;BR&gt;详见&lt;LINK&gt;帮助&lt;/LINK&gt;"/>
    <lblMoveStrFrom Caption="起始位置："/>
    <rbtMoveStrFromBegin Caption="从开头"/>
    <rbtMoveStrFromEnd Caption="从结尾"/>
    <lblMoveStrCount Caption="要移动的字符数："/>
    <lblMoveStrTo Caption="目标位置："/>
    <rbtMoveStrToBegin Caption="从开头"/>
    <rbtMoveStrToEnd Caption="从结尾"/>
    <lblMoveStrNotes Caption="说明：&lt;br&gt;- 如需移动指定的字符串，但它并非总在同一位置，请先用&lt;link&gt;字符串替换&lt;/link&gt;将其删除，再用&lt;link&gt;插入字符串&lt;/link&gt;将其插入到新位置&lt;BR&gt;- “目标位置”的值不包含被移动的字符（即视为它们已被删除）"/>
    <lblCharDel Caption="要删除的字符数："/>
    <rbtCharDelPos Caption="位置："/>
    <rbtCharDelBegin Caption="从开头"/>
    <rbtCharDelEnd Caption="从结尾"/>
    <rbtCharDelStr Caption="字符串之后："/>
    <rbtCharDelStr2 Caption="字符串之前："/>
    <cbxCharDelExt Caption="应用于扩展名而非名称"/>
    <lblCharDelNotes Caption="说明：&lt;BR&gt;- 如需删除指定的字符串，请使用&lt;LINK&gt;字符串替换&lt;/LINK&gt;操作，并将其替换为空字符串"/>
    <lblEnumMask Caption="掩码："/>
    <lblEnumStart Caption="起始值："/>
    <lblEnumDigits Caption="位数："/>
    <lblEnumIncr Caption="增量："/>
    <cbxEnumRestart Caption="切换文件夹时返回起始值"/>
    <cbxEnumSharePairs Caption="文件同名但扩展名不同时使用相同编号（例如 JPG + RAW + XMP）"/>
    <cbxExifNumSharePairs Caption="文件同名但扩展名不同时使用相同编号（例如 JPG + RAW + XMP）"/>
<n/>    <lblEnumNotes Caption="说明：&lt;BR&gt;- %name% = 原文件名（不含扩展名）&lt;BR&gt;- %ext% = 原扩展名（含点）&lt;BR&gt;- %num% = 编号&lt;BR&gt;- %folderN% = 文件夹名称，N 为层级（1 = 当前，2 = 上级，依此类推）&lt;BR&gt;- %% = % 字符&lt;BR&gt;详见&lt;LINK&gt;帮助&lt;/LINK&gt;"/>
    <lblMP3Mask Caption="掩码："/>
    <cbxMP3TwoDigit Caption="两位数音轨号（如需要则在编号前插入 '0'）"/>
    <cbxMP3Convert Caption="转换 ? / \ : &lt; &gt; | ? * 等非法字符"/>
<n/>    <lblMP3Notes Caption="说明：&lt;BR&gt;- %author% = 作者&lt;BR&gt;- %title% = 标题&lt;BR&gt;- %album% = 专辑&lt;BR&gt;- %year% = 年份&lt;BR&gt;- %genre% = 流派&lt;BR&gt;- %comm% = 注释&lt;BR&gt;- %track% = 音轨号（ID3V1.1）&lt;BR&gt;- %name% = 原文件名（不含扩展名）&lt;BR&gt;- %ext% = 原扩展名（含点）&lt;BR&gt;- %folderN% = 文件夹名称，N 为层级（1 = 当前，2 = 上级，依此类推）&lt;BR&gt;- %% = % 字符&lt;BR&gt;- $if(cond,true-value,false-value) 保持不变&lt;BR&gt;详见&lt;LINK&gt;帮助&lt;/LINK&gt;"/>
    <lblDTMask Caption="掩码："/>
    <cbxDTSuffix Caption="若存在多个日期/时间相同的文件则添加后缀"/>
    <lblDTWhich Caption="使用的日期："/>
    <rbtDTWhichCreation Caption="创建日期"/>
    <rbtDTWhichModif Caption="最后修改日期"/>
<n/>    <lblDTOffset Caption="偏移："/>
<n/>    <lblDTOffsetSec Caption="秒"/>
    <lblDTNotes Caption="说明："/>
    <lblDTNotes2>
      <Lines>
        <![CDATA[f	原文件名（不含扩展名）
e	原扩展名（含点）
c	使用 Windows 标准格式的日期和时间
d	不带前导零的日（1-31）
dd	带前导零的日（01-31）
ddd	日，简称（周日至周六）
dddd	日，全称（星期日至星期六）
ddddd	使用 Windows 短日期格式的日期
dddddd	使用 Windows 长日期格式的日期
m	不带前导零的月（1-12）
mm	带前导零的月（01-12）
mmm	月，简称（1月至12月）
mmmm	月，全称（1月至12月月份全名）
yy	年，两位数（00-99）
yyyy	年，四位数（0000-9999）
h	不带前导零的小时（0-23）
hh	带前导零的小时（00-23）
n	不带前导零的分钟（0-59）
nn	带前导零的分钟（00-59）
s	不带前导零的秒（0-59）
ss	带前导零的秒（00-59）
z	不带前导零的毫秒（0-999）
zzz	带前导零的毫秒（000-999）
am/pm	对前面的 h 或 hh 使用 12 小时制
a/p	对前面的 h 或 hh 使用 12 小时制
'xx'/“xx”	用单引号或双引号括起的字符保持不变

若 m 或 mm 紧跟在 h 或 hh 之后，则使用分钟而非月份]]>
      </Lines>
    </lblDTNotes2>
    <lblRandomMask Caption="掩码："/>
    <lblRandomMethod Caption="方法："/>
    <rbtRandomNumber Caption="随机数字（8 位）"/>
    <rbtRandomTick Caption="Windows 计时器计数"/>
