    <lblRandomNotes Caption="说明：&lt;BR&gt;- %name% = 原文件名（不含扩展名）&lt;BR&gt;- %ext% = 原扩展名（含点）&lt;BR&gt;- %random% = 随机生成的字符串&lt;BR&gt;- %% = % 字符&lt;BR&gt;详见&lt;LINK&gt;帮助&lt;/LINK&gt;"/>
    <rbtCaseWords Caption="将以下任意字符之后的首字母大写："/>
    <rbtCaseFirst Caption="将文件名的首字母大写"/>
    <rbtCaseUpper Caption="大写"/>
    <rbtCaseLower Caption="小写"/>
    <cbxCaseLocale Caption="使用 Windows 区域设置转换带重音的字符"/>
    <cbxCaseIncludeExt Caption="同时应用于扩展名"/>
    <cbxCaseOnlyExt Caption="应用于扩展名而非名称"/>
    <cbxFromListExt Caption="追加文件的原始扩展名"/>
    <cbxFromListOnlyExt Caption="将项目作为扩展名而非名称"/>
    <lblFromListNotes Caption="说明：&lt;BR&gt;- 此列表的每一行将作为一个文件的名称使用，项目按顺序取用&lt;BR&gt;- 如果行为空或行数不足，相应的文件将不会被重命名"/>
    <lblRegexp Caption="表达式："/>
    <lblRegexpRepl Caption="新名称："/>
    <lblRegexpNotes Caption="说明：&lt;BR&gt;- 可用 \ 字符转义特殊字符（如 $ 等），若要在新名称中表示单个 \，请使用 \\（如果您希望新名称指向其他文件夹）&lt;BR&gt;- 使用 ^ 表示名称开头，用 $ 表示名称结尾&lt;BR&gt;- 新名称必须包含 $1、$2 等，以指定匹配到的字符的放置位置&lt;BR&gt;有关正则表达式的更多信息，请参阅&lt;LINK&gt;帮助&lt;/LINK&gt;"/>
    <lblExifMask Caption="掩码："/>
<n/>    <lblExifOffset Caption="偏移："/>
<n/>    <lblExifOffsetSec Caption="秒"/>
    <lblExifNotes Caption="说明：&lt;BR&gt;- %name% = 原文件名（不含扩展名）&lt;BR&gt;- %ext% = 原扩展名（含点）&lt;BR&gt;- %datetimeoriginal% 或 %datetime% = 照片的原始日期和时间&lt;BR&gt;- %orientation% = 照片方向&lt;BR&gt;- %flash% = 闪光灯是否开启&lt;BR&gt;- %% = % 字符&lt;BR&gt;详细信息和 EXIF、IPTC、XMP 标签的完整列表请参阅&lt;LINK&gt;帮助&lt;/LINK&gt;"/>
