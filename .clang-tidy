# Static checks of the project (run by the CI, see CONTRIBUTING.md). Qt and system headers are not reported.
# Left out on purpose: easily-swappable-parameters and narrowing-conversions (too noisy with Qt's int/qsizetype),
# performance-enum-size (a few bytes of enum, not worth changing every enum), performance-no-int-to-ptr (Qt idiom for
# item data), bugprone-throwing-static-initialization (static QString / QRegularExpression constants),
# NewDeleteLeaks and NewDelete (false alarms: Qt parents own their children, and the analyzer does not follow the
# reference counting of Qt shared data, found with the clang-tidy 18 of Ubuntu 24.04).
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-throwing-static-initialization,
  performance-*,
  -performance-enum-size,
  -performance-no-int-to-ptr,
  clang-analyzer-*,
  -clang-analyzer-cplusplus.NewDeleteLeaks,
  -clang-analyzer-cplusplus.NewDelete,
  misc-redundant-expression,
  misc-unused-using-decls,
  modernize-use-nullptr,
  modernize-use-override,
  readability-container-size-empty,
  readability-redundant-string-init
HeaderFilterRegex: '(app|core)/.*'
WarningsAsErrors: ''
